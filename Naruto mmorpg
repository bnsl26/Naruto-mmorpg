const express = require('express');
const http = require('http');
const { Server } = require('socket.io');
const path = require('path');

const app = express();
const server = http.createServer(app);
const io = new Server(server, {
    cors: { origin: "*" }
});

// Servir les fichiers statiques du dossier "public"
app.use(express.static(path.join(__dirname, 'public')));

// État des joueurs en mémoire
const players = {};

io.on('connection', (socket) => {
    console.log(`[CONNECTÉ] Joueur ${socket.id}`);

    // Création de personnage
    socket.on('createCharacter', (characterData) => {
        players[socket.id] = {
            id: socket.id,
            username: characterData.username || 'Shinobi',
            village: characterData.village,
            stats: characterData.stats,
            x: Math.random() * 600 + 100,
            y: Math.random() * 400 + 100,
            vx: 0,
            vy: 0,
            speed: 3 + (characterData.stats.speed * 0.2),
            color: characterData.village === 'Konoha' ? '#ff4444' : (characterData.village === 'Suna' ? '#ffbb00' : '#00ccff')
        };

        // Confirmer la création au joueur
        socket.emit('characterCreated', players[socket.id]);
        
        // Mettre à jour tous les clients
        io.emit('updatePlayers', players);
    });

    // Déplacement vectoriel 360° (Joystick Mobile / Clavier)
    socket.on('playerMoveVector', (vector) => {
        const player = players[socket.id];
        if (!player) return;

        player.vx = vector.vx;
        player.vy = vector.vy;
    });

    // Attaque / Jutsus
    socket.on('useJutsu', (data) => {
        const player = players[socket.id];
        if (!player) return;

        io.emit('jutsuTriggered', {
            playerId: socket.id,
            jutsuType: data.type,
            x: player.x,
            y: player.y
        });
    });

    // Déconnexion
    socket.on('disconnect', () => {
        console.log(`[DÉCONNECTÉ] Joueur ${socket.id}`);
        delete players[socket.id];
        io.emit('updatePlayers', players);
    });
});

// Boucle de mise à jour physique du serveur (60 FPS)
setInterval(() => {
    for (let id in players) {
        const p = players[id];
        p.x += p.vx * p.speed;
        p.y += p.vy * p.speed;

        // Limites de la carte
        p.x = Math.max(20, Math.min(1200, p.x));
        p.y = Math.max(20, Math.min(800, p.y));
    }
    io.emit('updatePositions', players);
}, 1000 / 60);

const PORT = process.env.PORT || 3000;
server.listen(PORT, () => {
    console.log(`Serveur démarré sur http://localhost:${PORT}`);
});

