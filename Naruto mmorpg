<body>

    <!-- CRÉATION DE PERSONNAGE -->
    <div id="creation-screen">
        <div class="creator-box">
            <div>
                <h2>Créer un Ninja</h2>
                <div class="input-group">
                    <label>Nom du Shinobi</label>
                    <input type="text" id="username" placeholder="Ex: Naruto" maxlength="12">
                </div>
                <div class="input-group">
                    <label>Village d'origine</label>
                    <div class="village-options">
                        <div class="v-btn active" data-v="Konoha">🔥 Konoha</div>
                        <div class="v-btn" data-v="Suna">⏳ Suna</div>
                        <div class="v-btn" data-v="Kiri">🌊 Kiri</div>
                    </div>
                </div>
                <div class="input-group">
                    <label>Points d'attributs (Restants: <span id="pts">10</span>)</label>
                    <div class="stat-row">
                        <span>⚔️ Attaque</span>
                        <div>
                            <button class="stat-btn" onclick="addStat('atk', -1)">-</button>
                            <span id="v-atk">5</span>
                            <button class="stat-btn" onclick="addStat('atk', 1)">+</button>
                        </div>
                    </div>
                    <div class="stat-row">
                        <span>⚡ Vitesse</span>
                        <div>
                            <button class="stat-btn" onclick="addStat('speed', -1)">-</button>
                            <span id="v-speed">5</span>
                            <button class="stat-btn" onclick="addStat('speed', 1)">+</button>
                        </div>
                    </div>
                </div>
            </div>
            <div style="display: flex; flex-direction: column; justify-content: flex-end;">
                <button class="btn-submit" onclick="confirmCharacter()">ENTRER DANS L'ARÈNE</button>
            </div>
        </div>
    </div>

    <!-- CANVAS DU JEU -->
    <canvas id="gameCanvas"></canvas>

    <!-- JOYSTICK MOBILE -->
    <div id="joystick-zone">
        <div id="joystick-base">
            <div id="joystick-stick"></div>
        </div>
    </div>

    <!-- BOUTONS D'ACTIONS MOBILE -->
    <div id="touch-actions">
        <button class="action-btn atk-btn" id="btn-atk">⚔️</button>
        <button class="action-btn" id="btn-j1">J1</button>
    </div>

    <script>
        const socket = io();
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        // --- DONNÉES DU PERSONNAGE ---
        let pts = 10;
        let stats = { atk: 5, speed: 5 };
        let village = 'Konoha';

        document.querySelectorAll('.v-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.v-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                village = btn.dataset.v;
            });
        });

        function addStat(type, val) {
            if (val > 0 && pts > 0) { stats[type]++; pts--; }
            else if (val < 0 && stats[type] > 5) { stats[type]--; pts++; }
            document.getElementById(`v-${type}`).innerText = stats[type];
            document.getElementById('pts').innerText = pts;
        }

        function confirmCharacter() {
            const username = document.getElementById('username').value.trim() || 'Shinobi';
            socket.emit('createCharacter', { username, village, stats });
        }

        socket.on('characterCreated', () => {
            document.getElementById('creation-screen').style.display = 'none';
        });

        // --- JOYSTICK TACTILE FLOTTANT ---
        class Joystick {
            constructor() {
                this.zone = document.getElementById('joystick-zone');
                this.base = document.getElementById('joystick-base');
                this.stick = document.getElementById('joystick-stick');
                this.touchId = null;
                this.origin = { x: 0, y: 0 };
                this.maxR = 45;

                this.zone.addEventListener('touchstart', (e) => this.start(e), { passive: false });
                this.zone.addEventListener('touchmove', (e) => this.move(e), { passive: false });
                this.zone.addEventListener('touchend', (e) => this.end(e), { passive: false });
            }

            start(e) {
                e.preventDefault();
                if (this.touchId !== null) return;
                const t = e.changedTouches[0];
                this.touchId = t.identifier;
                this.origin = { x: t.clientX, y: t.clientY };
                this.base.style.left = `${this.origin.x}px`;
                this.base.style.top = `${this.origin.y}px`;
                this.base.style.display = 'block';
            }

            move(e) {
                e.preventDefault();
                const t = Array.from(e.touches).find(t => t.identifier === this.touchId);
                if (!t) return;

                const dx = t.clientX - this.origin.x;
                const dy = t.clientY - this.origin.y;
                const dist = Math.hypot(dx, dy);
                const angle = Math.atan2(dy, dx);
                const clamped = Math.min(dist, this.maxR);

                const sx = Math.cos(angle) * clamped;
                const sy = Math.sin(angle) * clamped;

                this.stick.style.transform = `translate(${sx}px, ${sy}px)`;
                socket.emit('playerMoveVector', { vx: sx / this.maxR, vy: sy / this.maxR });
            }

            end(e) {
                e.preventDefault();
                this.touchId = null;
                this.base.style.display = 'none';
                this.stick.style.transform = `translate(0px, 0px)`;
                socket.emit('playerMoveVector', { vx: 0, vy: 0 });
            }
        }
        new Joystick();

        // CONTRÔLES CLAVIER (Pour joueurs PC)
        const keys = { z: false, s: false, q: false, d: false };
        window.addEventListener('keydown', (e) => updateKey(e.key.toLowerCase(), true));
        window.addEventListener('keyup', (e) => updateKey(e.key.toLowerCase(), false));

        function updateKey(key, state) {
            if (['z','w','arrowup'].includes(key)) keys.z = state;
            if (['s','arrowdown'].includes(key)) keys.s = state;
            if (['q','a','arrowleft'].includes(key)) keys.q = state;
            if (['d','arrowright'].includes(key)) keys.d = state;

            let vx = 0, vy = 0;
            if (keys.z) vy -= 1;
            if (keys.s) vy += 1;
            if (keys.q) vx -= 1;
            if (keys.d) vx += 1;

            socket.emit('playerMoveVector', { vx, vy });
        }

        // BOUTONS D'ATTAQUE
        document.getElementById('btn-atk').addEventListener('touchstart', (e) => {
            e.preventDefault();
            socket.emit('useJutsu', { type: 'Attaque' });
        });

        // --- RENDU CANVAS EN TEMPS RÉEL ---
        let allPlayers = {};
        let effects = [];

        socket.on('updatePositions', (players) => { allPlayers = players; });
        socket.on('updatePlayers', (players) => { allPlayers = players; });

        socket.on('jutsuTriggered', (data) => {
            effects.push({ x: data.x, y: data.y, r: 10, alpha: 1 });
        });

        function render() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // Dessiner les effets / attaques
            effects.forEach((eff, i) => {
                ctx.beginPath();
                ctx.arc(eff.x, eff.y, eff.r, 0, Math.PI * 2);
                ctx.strokeStyle = `rgba(255, 153, 0, ${eff.alpha})`;
                ctx.lineWidth = 3;
                ctx.stroke();
                eff.r += 2;
                eff.alpha -= 0.05;
                if (eff.alpha <= 0) effects.splice(i, 1);
            });

            // Dessiner tous les joueurs
            for (let id in allPlayers) {
                const p = allPlayers[id];

                // Corps du joueur
                ctx.beginPath();
                ctx.arc(p.x, p.y, 20, 0, Math.PI * 2);
                ctx.fillStyle = p.color;
                ctx.fill();
                ctx.lineWidth = 2;
                ctx.strokeStyle = '#ffffff';
                ctx.stroke();

                // Nom du joueur
                ctx.fillStyle = '#ffffff';
                ctx.font = 'bold 12px sans-serif';
                ctx.textAlign = 'center';
                ctx.fillText(p.username, p.x, p.y - 28);
            }

            requestAnimationFrame(render);
        }
        render();
    </script>
</body>
</html>

